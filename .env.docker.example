# Local Docker onboarding only. No university or production credentials.
# npm run local:setup creates .env.docker with random passwords if it is absent.
# Alternatively copy this file to .env.docker and replace BOTH placeholders
# privately with different random 24-128 character passwords (A-Z, a-z, 0-9, _ or -).
# Existing files are never overwritten. Never commit .env.docker.
LOCAL_COMPOSE_PROJECT=vocabulary-local
LOCAL_POSTGRES_PORT=5433
LOCAL_API_PORT=3000
LOCAL_WEB_PORT=5173
LOCAL_MIGRATOR_PASSWORD=REPLACE_MIGRATOR_PASSWORD
LOCAL_APP_PASSWORD=REPLACE_APP_PASSWORD
