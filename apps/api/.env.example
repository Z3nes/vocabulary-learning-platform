# API server (development defaults). Copy to apps/api/.env; never commit .env.
HOST=127.0.0.1
PORT=3000
# Path prefix for every API route. Must match the web app's proxy target path.
API_PREFIX=/api
LOG_LEVEL=info
# Explicit local-only identity. Never use dev authentication in production.
AUTH_MODE=dev
# Replace password placeholders privately. Percent-encode URL-special password
# characters (for example @ -> %40, : -> %3A, / -> %2F, # -> %23, % -> %25).
# Runtime NEVER uses the migration connection.
DATABASE_URL=postgresql://kelime_app:APP_PASSWORD_URL_ENCODED@127.0.0.1:5432/kelime_platform_dev
MIGRATION_DATABASE_URL=postgresql://kelime_migrator:MIGRATOR_PASSWORD_URL_ENCODED@127.0.0.1:5432/kelime_platform_dev
SHADOW_DATABASE_URL=postgresql://kelime_migrator:MIGRATOR_PASSWORD_URL_ENCODED@127.0.0.1:5432/kelime_platform_shadow
TEST_DATABASE_URL=postgresql://kelime_app:APP_PASSWORD_URL_ENCODED@127.0.0.1:5432/kelime_platform_test
TEST_MIGRATION_DATABASE_URL=postgresql://kelime_migrator:MIGRATOR_PASSWORD_URL_ENCODED@127.0.0.1:5432/kelime_platform_test
