# Web app (Vite). Copy to apps/web/.env.local for local overrides; never commit it.

# Deployment base path. "/" serves the app at the domain root; "/kelime/" serves it
# under a sub-path. React Router and asset URLs follow this value automatically.
VITE_BASE_PATH=/

# Optional. Browser-facing API path; defaults to "<VITE_BASE_PATH>api" (same origin).
# VITE_API_BASE_PATH=/kelime/api

# Development proxy only (not exposed to the browser bundle).
# Where `npm run dev` forwards API requests, and the API's API_PREFIX (apps/api/.env).
DEV_API_TARGET=http://127.0.0.1:3000
DEV_API_PREFIX=/api
